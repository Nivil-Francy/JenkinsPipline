pipeline {
agent any
environment {
    PATH = "/opt/homebrew/bin:/Users/nivilfrancy/.docker/bin:${env.PATH}"

    APP_NAME = 'jenkins-assessment'
    IMAGE_NAME = 'jenkins-assessment'

    STAGING_CONTAINER = 'jenkins-assessment-staging'
    PRODUCTION_CONTAINER = 'jenkins-assessment-production'

    STAGING_PORT = '3001'
    PRODUCTION_PORT = '3000'
}

stages {

    stage('Build') {
        steps {
            echo '=== BUILD STAGE ==='

            echo 'Checking installed tools...'

            sh 'node --version'
            sh 'npm --version'
            sh 'docker --version'

            echo 'Installing project dependencies...'

            sh 'npm ci'

            echo 'Building versioned Docker image...'

            sh '''
                docker build \
                    -t ${IMAGE_NAME}:${BUILD_NUMBER} \
                    -t ${IMAGE_NAME}:latest .
            '''

            echo "Docker image created: ${IMAGE_NAME}:${BUILD_NUMBER}"

            echo 'Saving Docker image as build artefact...'

            sh '''
                docker save ${IMAGE_NAME}:${BUILD_NUMBER} \
                    -o ${IMAGE_NAME}-${BUILD_NUMBER}.tar
            '''

            archiveArtifacts artifacts: "${IMAGE_NAME}-${BUILD_NUMBER}.tar",
                             fingerprint: true
        }
    }

    stage('Test') {
        steps {
            echo '=== TEST STAGE ==='

            echo 'Running automated unit and API integration tests...'

            sh 'npm test -- --coverage'
        }

        post {
            always {
                echo 'Archiving test coverage...'

                archiveArtifacts artifacts: 'coverage/**',
                                 allowEmptyArchive: true
            }
        }
    }

    stage('Code Quality') {
        steps {
            echo '=== CODE QUALITY STAGE ==='

            echo 'Running ESLint static code analysis...'

            sh 'npm run lint'

            script {
                def scannerHome = tool 'SonarScanner'

                withSonarQubeEnv('SonarCloud') {
                    sh "${scannerHome}/bin/sonar-scanner"
                }
            }

            echo 'SonarCloud analysis completed successfully.'
        }
    }

    stage('Security') {
        steps {
            echo '=== SECURITY STAGE ==='

            echo 'Running npm dependency security audit...'

            sh 'npm audit --audit-level=high'

            echo 'Dependency security audit passed.'

            echo 'Running Docker image vulnerability scan with Trivy...'

            sh '''
                docker run --rm \
                    -v /var/run/docker.sock:/var/run/docker.sock \
                    aquasec/trivy:latest image \
                    --severity HIGH,CRITICAL \
                    --exit-code 1 \
                    ${IMAGE_NAME}:${BUILD_NUMBER}
            '''

            echo 'Trivy security scan passed.'
        }
    }

    stage('Deploy to Staging') {
        steps {
            echo '=== STAGING DEPLOYMENT ==='

            echo 'Removing previous staging container if it exists...'

            sh '''
                docker rm -f ${STAGING_CONTAINER} 2>/dev/null || true
            '''

            echo 'Deploying application to staging...'

            sh '''
                docker run -d \
                    --name ${STAGING_CONTAINER} \
                    -p ${STAGING_PORT}:3000 \
                    -e NODE_ENV=staging \
                    ${IMAGE_NAME}:${BUILD_NUMBER}
            '''

            echo 'Waiting for staging application...'

            sh 'sleep 5'

            echo 'Running staging health check...'

            sh '''
                curl --fail \
                    --max-time 10 \
                    http://localhost:${STAGING_PORT}/health
            '''

            echo 'Staging deployment successful.'
        }
    }

    stage('Release to Production') {
        steps {
            echo '=== PRODUCTION RELEASE ==='

            echo "Creating release version ${BUILD_NUMBER}..."

            sh '''
                docker tag \
                    ${IMAGE_NAME}:${BUILD_NUMBER} \
                    ${IMAGE_NAME}:release-${BUILD_NUMBER}
            '''

            script {

                def previousImage = sh(
                    script: """
                        docker inspect \
                            --format='{{.Config.Image}}' \
                            ${PRODUCTION_CONTAINER} 2>/dev/null || true
                    """,
                    returnStdout: true
                ).trim()

                echo "Previous production image: ${previousImage ?: 'None'}"

                try {

                    echo "Deploying release-${BUILD_NUMBER} to production..."

                    sh '''
                        docker rm -f ${PRODUCTION_CONTAINER} 2>/dev/null || true

                        docker run -d \
                            --name ${PRODUCTION_CONTAINER} \
                            -p ${PRODUCTION_PORT}:3000 \
                            -e NODE_ENV=production \
                            ${IMAGE_NAME}:release-${BUILD_NUMBER}
                    '''

                    echo 'Waiting for production application...'

                    sh 'sleep 5'

                    echo 'Running production health check...'

                    sh '''
                        curl --fail \
                            --max-time 10 \
                            http://localhost:${PRODUCTION_PORT}/health
                    '''

                    echo "Production release ${BUILD_NUMBER} deployed successfully."

                } catch (Exception deploymentError) {

                    echo 'PRODUCTION DEPLOYMENT FAILED'
                    echo 'Starting automated rollback...'

                    if (previousImage) {

                        sh '''
                            docker rm -f ${PRODUCTION_CONTAINER} 2>/dev/null || true

                            docker run -d \
                                --name ${PRODUCTION_CONTAINER} \
                                -p ${PRODUCTION_PORT}:3000 \
                                -e NODE_ENV=production \
                                ${previousImage}
                        '''

                        sh 'sleep 5'

                        sh '''
                            curl --fail \
                                --max-time 10 \
                                http://localhost:${PRODUCTION_PORT}/health
                        '''

                        echo 'AUTOMATED ROLLBACK SUCCESSFUL'
                        echo "Restored previous image: ${previousImage}"

                    } else {

                        echo 'No previous production image available for rollback.'
                    }

                    throw deploymentError
                }
            }
        }
    }

    stage('Monitoring') {
        steps {
            echo '=== MONITORING STAGE ==='

            echo 'Checking production health...'

            sh '''
                curl --fail \
                    --max-time 10 \
                    http://localhost:${PRODUCTION_PORT}/health
            '''

            echo 'Checking production API...'

            sh '''
                curl --fail \
                    --max-time 10 \
                    http://localhost:${PRODUCTION_PORT}/api/status
            '''

            echo 'Collecting production performance metrics...'

            sh '''
                response_times=""

                for i in 1 2 3 4 5
                do
                    response_time=$(curl -s \
                        -o /dev/null \
                        -w '%{time_total}' \
                        --max-time 10 \
                        http://localhost:${PRODUCTION_PORT}/health)

                    response_ms=$(awk -v time="$response_time" 'BEGIN {printf "%.2f", time * 1000}')

                    echo "Metric sample $i: $response_ms ms"

                    response_times="$response_times $response_ms"
                done

                echo "Calculating performance statistics..."

                average=$(printf '%s\n' "$response_times" | awk '{
                    sum=0
                    count=0

                    for (i=1; i<=NF; i++) {
                        sum += $i
                        count++
                    }

                    if (count > 0) {
                        printf "%.2f", sum/count
                    }
                }')

                maximum=$(printf '%s\n' "$response_times" | awk '{
                    max=$1

                    for (i=2; i<=NF; i++) {
                        if ($i > max) {
                            max=$i
                        }
                    }

                    printf "%.2f", max
                }')

                echo "Average response time: $average ms"
                echo "Maximum response time: $maximum ms"
                echo "Alert threshold: 1000 ms"

                if awk -v max="$maximum" 'BEGIN {exit !(max > 1000)}'
                then
                    echo "ALERT: Response time exceeded 1000 ms"
                    exit 1
                else
                    echo "ALERT RULE PASSED: Response time is below 1000 ms"
                fi
            '''

            echo 'Collecting Docker resource metrics...'

            sh '''
                docker stats --no-stream \
                    --format "CPU={{.CPUPerc}} MEM={{.MemUsage}} MEM_PCT={{.MemPerc}}" \
                    ${PRODUCTION_CONTAINER}
            '''

            echo 'Production monitoring checks passed.'

            echo 'Starting incident simulation...'

            sh '''
                echo "Stopping production container to simulate an incident..."

                docker stop ${PRODUCTION_CONTAINER}

                echo "Checking whether the monitoring check detects the failure..."

                if curl --silent --fail \
                    --max-time 5 \
                    http://localhost:${PRODUCTION_PORT}/health
                then

                    echo "WARNING: Production health check unexpectedly succeeded."

                else

                    echo "ALERT: Production application is unavailable."

                fi

                echo "Recovering production service..."

                docker start ${PRODUCTION_CONTAINER}

                sleep 5

                echo "Verifying service recovery..."

                curl --fail \
                    --max-time 10 \
                    http://localhost:${PRODUCTION_PORT}/health

                echo "INCIDENT RECOVERY: Production service restored."
            '''
        }
    }
}

post {

    success {
        echo '''
'''
}
    failure {
        echo '''
'''
}
    always {
        echo "Build Number: ${BUILD_NUMBER}"
        echo "Application: ${APP_NAME}"
    }
}
}